datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  auditLogs  AuditLog[]
  leads      Lead[]
  deals      Deal[]
  tasks      Task[]
  activities Activity[]
  meetings   Meeting[]
  proposals  Proposal[]
  customers  Customer[]
  invoices   Invoice[]
  companyProfile CompanyProfile?
  systemSettings SystemSetting[]
  savedReports   SavedReport[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  roleId         String       @map("role_id")
  name           String
  email          String       @unique
  phone          String?
  passwordHash   String       @map("password_hash")
  status         String       @default("ACTIVE")
  avatarUrl      String?      @map("avatar_url")
  teamName       String?      @map("team_name")
  dataScope      String?      @default("ALL") @map("data_scope")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  ownedLeads      Lead[]              @relation("LeadOwner")
  nextActionLeads Lead[]              @relation("LeadNextActionOwner")
  qualifiedLeads  LeadQualification[] @relation("LeadQualifier")
  ownedDeals      Deal[]              @relation("DealOwner")
  assignedTasks   Task[]              @relation("TaskAssignee")
  createdTasks    Task[]              @relation("TaskCreator")
  activities      Activity[]          @relation("ActivityUser")
  ownedMeetings    Meeting[]           @relation("MeetingOwner")
  createdMeetings  Meeting[]           @relation("MeetingCreator")
  ownedProposals   Proposal[]          @relation("ProposalOwner")
  createdProposals Proposal[]          @relation("ProposalCreator")
  ownedCustomers   Customer[]          @relation("CustomerOwner")
  createdInvoices  Invoice[]           @relation("InvoiceCreator")
  savedReports     SavedReport[]

  @@index([organizationId])
  @@index([roleId])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(true) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  isRevoked Boolean   @default(false) @map("is_revoked")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  userId         String?       @map("user_id")
  action         String
  resource       String
  resourceId     String?       @map("resource_id")
  details        Json?
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  requestId      String?       @map("request_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model PipelineStage {
  id                  String   @id @default(uuid())
  name                String
  order               Int
  stageType           String   @map("stage_type")
  dealCountBenchmark  Int      @default(0) @map("deal_count_benchmark")
  totalValueBenchmark Decimal  @default(0) @map("total_value_benchmark")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  deals               Deal[]

  @@index([order])
  @@map("pipeline_stages")
}

model LostReason {
  id        String   @id @default(uuid())
  code      String   @unique
  label     String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deals     Deal[]

  @@map("lost_reasons")
}

model Lead {
  id                String             @id @default(uuid())
  organizationId    String             @map("organization_id")
  ownerId           String             @map("owner_id")
  fullName          String             @map("full_name")
  companyName       String?            @map("company_name")
  title             String?
  phone             String
  email             String?
  source            String             // META_ADS, GOOGLE_ADS, WEBSITE_FORM, WHATSAPP, MANUAL, IMPORT, PHONE_INBOUND
  
  // Separation of Lifecycle Status, Priority, and Temperature
  status            String             @default("NEW") // NEW, CONTACTED, QUALIFIED, UNQUALIFIED, CONVERTED, LOST
  priority          String             @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  temperature       String?            // HOT, WARM, COLD (Optional)
  
  // Scoring
  leadScore         Int?               @map("lead_score") // Nullable, range 0–100
  serviceInterest   String             @map("service_interest")
  category          String?
  
  // Unqualification Governance (BR-QUAL-03)
  unqualifiedReason String?            @map("unqualified_reason")
  unqualifiedNotes  String?            @map("unqualified_notes")
  
  // Lightweight Lead-Level Next Action Snapshot (BR-ACT-01)
  lastActivityAt    DateTime           @default(now()) @map("last_activity_at")
  nextActionDueAt   DateTime?          @map("next_action_due_at")
  nextActionType    String?            @map("next_action_type") // CALL, WHATSAPP, EMAIL, MEETING, PROPOSAL, INTERNAL_REVIEW
  nextActionPurpose String?            @map("next_action_purpose")
  nextActionOwnerId String?            @map("next_action_owner_id")
  
  // Soft Deletion
  deletedAt         DateTime?          @map("deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User               @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  nextActionOwner   User?              @relation("LeadNextActionOwner", fields: [nextActionOwnerId], references: [id], onDelete: SetNull)
  qualification     LeadQualification?
  deals             Deal[]
  tasks             Task[]
  activities        Activity[]
  meetings          Meeting[]
  proposals         Proposal[]
  customers         Customer[]         @relation("LeadCustomer")
  invoices          Invoice[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([phone])
  @@index([email])
  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([nextActionDueAt])
  @@map("leads")
}

model LeadQualification {
  id                String       @id @default(uuid())
  leadId            String       @unique @map("lead_id")
  
  // Structured BANT Criteria (BR-QUAL-01)
  budgetAmount      Decimal?     @map("budget_amount") @db.Decimal(12, 2)
  budgetStatus      String?      @map("budget_status") // CONFIRMED, ESTIMATED, EXPLORING, NO_BUDGET
  authorityLevel    String?      @map("authority_level") // DECISION_MAKER, INFLUENCER, EVALUATOR, GATEKEEPER
  timelineHorizon   String?      @map("timeline_horizon") // IMMEDIATE_2WEEKS, ONE_MONTH, THREE_MONTHS, EXPLORING
  urgencyRating     Int?         @default(3) @map("urgency_rating") // 1 to 5
  problemStatement  String?      @map("problem_statement") @db.Text
  notes             String?      @db.Text
  
  qualifiedByUserId String?      @map("qualified_by_user_id")
  qualifiedAt       DateTime     @default(now()) @map("qualified_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  lead              Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  qualifiedByUser   User?        @relation("LeadQualifier", fields: [qualifiedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@map("lead_qualifications")
}

model Deal {
  id                String         @id @default(uuid())
  organizationId    String         @map("organization_id")
  ownerId           String         @map("owner_id")
  leadId            String         @map("lead_id")
  stageId           String         @map("stage_id")
  title             String
  value             Decimal        @default(0) @db.Decimal(14, 2)
  expectedCloseDate DateTime?      @map("expected_close_date")
  probability       Int?           @default(50)
  status            String         @default("OPEN") // OPEN, WON, LOST
  lostReasonId      String?        @map("lost_reason_id")
  lostReasonNotes   String?        @map("lost_reason_notes") @db.Text
  closedAt          DateTime?      @map("closed_at")
  wonNotes          String?        @map("won_notes") @db.Text
  deletedAt         DateTime?      @map("deleted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User           @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  lead              Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage             PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  lostReason        LostReason?    @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)

  tasks             Task[]
  activities        Activity[]
  meetings          Meeting[]
  proposals         Proposal[]
  customers         Customer[]     @relation("DealCustomer")
  invoices          Invoice[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([leadId])
  @@index([stageId])
  @@index([status])
  @@index([expectedCloseDate])
  @@index([createdAt])
  @@map("deals")
}

model Task {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  assigneeId      String       @map("assignee_id")
  creatorId       String?      @map("creator_id")
  leadId          String?      @map("lead_id")
  dealId          String?      @map("deal_id")
  taskType        String       @default("FOLLOW_UP") @map("task_type") // CALL, WHATSAPP, EMAIL, MEETING, PROPOSAL, FOLLOW_UP, REVIEW, OTHER
  title           String
  description     String?      @db.Text
  dueDate         DateTime     @map("due_date")
  priority        String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String       @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  completedAt     DateTime?    @map("completed_at")
  completionNotes String?      @map("completion_notes") @db.Text
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee        User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  creator         User?        @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal            Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  activities      Activity[]

  @@index([organizationId])
  @@index([assigneeId])
  @@index([leadId])
  @@index([dealId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([createdAt])
  @@map("tasks")
}

model Activity {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  userId          String       @map("user_id")
  leadId          String?      @map("lead_id")
  dealId          String?      @map("deal_id")
  taskId          String?      @map("task_id")
  meetingId       String?      @map("meeting_id")
  activityType    String       @map("activity_type") // CALL, EMAIL, WHATSAPP, NOTE, MEETING, TASK, SYSTEM
  direction       String?      // INBOUND, OUTBOUND
  subject         String
  description     String?      @db.Text
  activityDate    DateTime     @default(now()) @map("activity_date")
  durationSeconds Int?         @map("duration_seconds")
  outcome         String?
  metadata        Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation("ActivityUser", fields: [userId], references: [id], onDelete: Restrict)
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal            Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  task            Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  meeting         Meeting?     @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([leadId])
  @@index([dealId])
  @@index([taskId])
  @@index([meetingId])
  @@index([activityType])
  @@index([activityDate])
  @@index([createdAt])
  @@map("activities")
}

model Meeting {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  leadId         String?      @map("lead_id")
  customerId     String?      @map("customer_id")
  dealId         String?      @map("deal_id")
  title          String
  description    String?      @db.Text
  meetingType    String       @default("MEETING") @map("meeting_type") // MEETING, DEMO, DISCOVERY, FOLLOW_UP
  startTime      DateTime     @map("start_time")
  endTime        DateTime     @map("end_time")
  duration       String?
  meetingUrl     String?      @map("meeting_url")
  location       String?
  whatsappMessage String?     @map("whatsapp_message") @db.Text
  ownerId        String       @map("owner_id")
  creatorId      String?      @map("creator_id")
  status         String       @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  outcome        String?
  notes          String?      @db.Text
  completedAt    DateTime?    @map("completed_at")
  cancelledAt    DateTime?    @map("cancelled_at")
  cancelReason   String?      @map("cancel_reason")
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner          User         @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator        User?        @relation("MeetingCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  activities     Activity[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
  @@index([status])
  @@index([startTime])
  @@index([meetingType])
  @@index([createdAt])
  @@map("meetings")
}

model Proposal {
  id              String       @id @default(uuid())
  organizationId  String       @map("organization_id")
  leadId          String?      @map("lead_id")
  customerId      String?      @map("customer_id")
  dealId          String?      @map("deal_id")
  proposalNumber  String       @map("proposal_number")
  title           String
  description     String?      @db.Text
  subtotal        Decimal      @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal      @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxAmount       Decimal      @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount     Decimal      @default(0) @map("total_amount") @db.Decimal(14, 2)
  currency        String       @default("INR")
  validUntil      DateTime?    @map("valid_until")
  status          String       @default("DRAFT") // DRAFT, SENT, VIEWED, NEGOTIATION, ACCEPTED, REJECTED, EXPIRED, CANCELLED
  ownerId         String       @map("owner_id")
  creatorId       String?      @map("creator_id")
  sentAt          DateTime?    @map("sent_at")
  acceptedAt      DateTime?    @map("accepted_at")
  rejectedAt      DateTime?    @map("rejected_at")
  rejectionReason String?      @map("rejection_reason")
  notes           String?      @db.Text
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal            Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner           User         @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  creator         User?        @relation("ProposalCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  invoices        Invoice[]
  items           ProposalItem[]

  @@unique([organizationId, proposalNumber])
  @@index([organizationId])
  @@index([ownerId])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
  @@index([status])
  @@index([validUntil])
  @@index([createdAt])
  @@map("proposals")
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  leadId         String?      @map("lead_id")
  dealId         String?      @map("deal_id")
  companyName    String       @map("company_name")
  contactName    String       @map("contact_name")
  title          String?
  phone          String
  email          String
  address        String?
  city           String?
  state          String?
  postalCode     String?      @map("postal_code")
  country        String?      @default("India")
  category       String?
  purchasedServices String?   @map("purchased_services")
  status         String       @default("ACTIVE") // ACTIVE, INACTIVE, AT_RISK, CHURNED
  ownerId        String       @map("owner_id")
  customerSince  DateTime     @default(now()) @map("customer_since")
  notes          String?      @db.Text
  deletedAt      DateTime?    @map("deleted_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation("LeadCustomer", fields: [leadId], references: [id], onDelete: SetNull)
  deal           Deal?        @relation("DealCustomer", fields: [dealId], references: [id], onDelete: SetNull)
  owner          User         @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  meetings       Meeting[]
  proposals      Proposal[]
  invoices       Invoice[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([leadId])
  @@index([dealId])
  @@index([status])
  @@index([companyName])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@map("customers")
}

model Invoice {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  invoiceNumber    String        @map("invoice_number")
  poNumber         String?       @map("po_number")
  
  // Client Details
  title            String?
  clientName       String        @map("client_name")
  clientContact    String?       @map("client_contact")
  clientEmail      String?       @map("client_email")
  clientPhone      String?       @map("client_phone")
  clientAddress    String?       @map("client_address")
  clientTaxId      String?       @map("client_tax_id")

  // Optional CRM Links
  leadId           String?       @map("lead_id")
  customerId       String?       @map("customer_id")
  dealId           String?       @map("deal_id")
  proposalId       String?       @map("proposal_id")
  creatorId        String?       @map("creator_id")

  // Dates & Status
  issueDate        DateTime      @default(now()) @map("issue_date")
  dueDate          DateTime      @map("due_date")
  paymentTermsDays String?       @default("15") @map("payment_terms_days")
  status           String        @default("DRAFT") // DRAFT, SENT, PAID, PARTIALLY_PAID, OVERDUE, CANCELLED
  currency         String        @default("₹")
  paymentMethod    String?       @map("payment_method")
  paidAt           DateTime?     @map("paid_at")

  // Financials
  subtotal         Decimal       @default(0) @db.Decimal(12, 2)
  taxRate          Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountRate     Decimal       @default(0) @map("discount_rate") @db.Decimal(5, 2)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  total            Decimal       @default(0) @db.Decimal(12, 2)
  advanceAmount    Decimal       @default(0) @map("advance_amount") @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue       Decimal       @default(0) @map("balance_due") @db.Decimal(12, 2)

  // Content & Config
  notes            String?       @db.Text
  footerText       String?       @map("footer_text") @db.Text
  
  // Structured JSON fields for advanced studio capabilities
  senderProfile    Json?         @map("sender_profile")
  bankDetails      Json?         @map("bank_details")
  upiDetails       Json?         @map("upi_details")
  cryptoDetails    Json?         @map("crypto_details")
  signature        Json?         @map("signature")
  customColumns    Json?         @map("custom_columns")
  columnConfig     Json?         @map("column_config")
  activeTheme      Json?         @map("active_theme")
  rawData          Json?         @map("raw_data")

  // Soft Deletion & Timestamps
  deletedAt        DateTime?     @map("deleted_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  // Relations
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead             Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  deal             Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  proposal         Proposal?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  creator          User?         @relation("InvoiceCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([creatorId])
  @@index([leadId])
  @@index([customerId])
  @@index([dealId])
  @@index([proposalId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  description   String
  subdesc       String?
  quantity      Int      @default(1)
  price         Decimal  @default(0) @db.Decimal(12, 2)
  advanceAmount Decimal? @map("advance_amount") @db.Decimal(12, 2)
  customValues  Json?    @map("custom_values")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model CompanyProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique @map("organization_id")
  name           String
  email          String?
  phone          String?
  address        String?      @db.Text
  taxId          String?      @map("tax_id")
  website        String?
  logo           String?      @db.Text
  logoHeight     Int?         @default(48) @map("logo_height")
  bankAccounts   Json?        @map("bank_accounts")
  upiAccounts    Json?        @map("upi_accounts")
  cryptoAccounts Json?        @map("crypto_accounts")
  currencySymbol String?      @default("₹") @map("currency_symbol")
  navbarConfig   Json?        @map("navbar_config")
  invoiceTheme   Json?        @map("invoice_theme")
  generalSettings Json?       @map("general_settings")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model ProposalItem {
  id             String       @id @default(uuid())
  proposalId     String       @map("proposal_id")
  description    String
  quantity       Int          @default(1)
  unitPrice      Decimal      @default(0) @map("unit_price") @db.Decimal(14, 2)
  amount         Decimal      @default(0) @db.Decimal(14, 2)
  order          Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  proposal       Proposal     @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
  @@map("proposal_items")
}

model SystemSetting {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  key            String
  value          Json
  category       String       @default("GENERAL") // APPEARANCE, INVOICE, NOTIFICATIONS, INTEGRATIONS, GENERAL
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([category])
  @@map("system_settings")
}

model SavedReport {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  name           String
  reportType     String       @map("report_type") // PIPELINE, REVENUE, REPS, SOURCES, CONVERSION
  filters        Json?
  metrics        Json?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("saved_reports")
}

